rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBootstrapAdmin() {
      return isVerified() && request.auth.token.email == 'babelhendri@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'unit', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'unit', 'role', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 100
        && data.role == 'staff'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLetter(data) {
      return data.keys().hasAll([
          'ownerId', 'collaboratorUids', 'trackingCode', 'direction', 'letterNumber',
          'agendaNumber', 'subject', 'sender', 'recipient', 'originUnit', 'currentUnit',
          'letterDate', 'receivedOrSentDate', 'priority', 'classification', 'status',
          'summary', 'attachmentUrl', 'assignedToName', 'createdByName', 'eventCount',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'collaboratorUids', 'trackingCode', 'direction', 'letterNumber',
          'agendaNumber', 'subject', 'sender', 'recipient', 'originUnit', 'currentUnit',
          'letterDate', 'receivedOrSentDate', 'priority', 'classification', 'status',
          'summary', 'attachmentUrl', 'uploadedFileName', 'uploadedFileUrl',
          'uploadedFileMime', 'assignedToName', 'createdByName', 'eventCount',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.collaboratorUids is list
        && data.collaboratorUids.size() >= 1
        && data.collaboratorUids.size() <= 20
        && data.collaboratorUids[0] is string
        && data.collaboratorUids[0].size() >= 1
        && data.collaboratorUids[0].size() <= 128
        && data.trackingCode is string && data.trackingCode.size() >= 4 && data.trackingCode.size() <= 32 && data.trackingCode.matches('^[A-Z0-9\\-]+$')
        && data.direction in ['masuk', 'keluar']
        && data.letterNumber is string && data.letterNumber.size() >= 1 && data.letterNumber.size() <= 100
        && data.agendaNumber is string && data.agendaNumber.size() <= 64
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 240
        && data.sender is string && data.sender.size() >= 1 && data.sender.size() <= 160
        && data.recipient is string && data.recipient.size() >= 1 && data.recipient.size() <= 160
        && data.originUnit is string && data.originUnit.size() >= 1 && data.originUnit.size() <= 100
        && data.currentUnit is string && data.currentUnit.size() >= 1 && data.currentUnit.size() <= 100
        && data.letterDate is string && data.letterDate.size() <= 20 && data.letterDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.receivedOrSentDate is string && data.receivedOrSentDate.size() <= 20 && data.receivedOrSentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.priority in ['Biasa', 'Penting', 'Segera', 'Rahasia']
        && data.classification in ['Umum', 'Undangan', 'Keputusan', 'Keuangan', 'Kepegawaian', 'Nota Dinas']
        && data.status in ['Terdaftar', 'Diproses', 'Didisposisikan', 'Terkirim', 'Diterima', 'Selesai', 'Diarsipkan']
        && data.summary is string && data.summary.size() <= 2000
        && data.attachmentUrl is string && data.attachmentUrl.size() <= 500
        && (!('uploadedFileName' in data) || (data.uploadedFileName is string && data.uploadedFileName.size() <= 255))
        && (!('uploadedFileUrl' in data) || (data.uploadedFileUrl is string && data.uploadedFileUrl.size() <= 500))
        && (!('uploadedFileMime' in data) || (data.uploadedFileMime is string && data.uploadedFileMime.size() <= 120))
        && data.assignedToName is string && data.assignedToName.size() <= 120
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 120
        && data.eventCount is int && data.eventCount >= 1 && data.eventCount <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTrackingEvent(data, letterId) {
      return data.keys().hasAll([
          'letterId', 'ownerId', 'collaboratorUids', 'actorUid', 'actorName',
          'actionType', 'fromUnit', 'toUnit', 'statusAfter', 'note', 'createdAt'
        ])
        && data.keys().hasOnly([
          'letterId', 'ownerId', 'collaboratorUids', 'actorUid', 'actorName',
          'actionType', 'fromUnit', 'toUnit', 'statusAfter', 'note', 'createdAt'
        ])
        && data.letterId == letterId
        && isValidId(data.letterId)
        && isValidId(data.ownerId)
        && data.collaboratorUids is list
        && data.collaboratorUids.size() >= 1
        && data.collaboratorUids.size() <= 20
        && data.collaboratorUids[0] is string
        && data.collaboratorUids[0].size() >= 1
        && data.collaboratorUids[0].size() <= 128
        && data.actorUid == request.auth.uid
        && isValidId(data.actorUid)
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120
        && data.actionType in ['Registrasi', 'Verifikasi', 'Disposisi', 'Pengiriman', 'Penerimaan', 'Tindak Lanjut', 'Selesai', 'Arsip']
        && data.fromUnit is string && data.fromUnit.size() >= 1 && data.fromUnit.size() <= 100
        && data.toUnit is string && data.toUnit.size() >= 1 && data.toUnit.size() <= 100
        && data.statusAfter in ['Terdaftar', 'Diproses', 'Didisposisikan', 'Terkirim', 'Diterima', 'Selesai', 'Diarsipkan']
        && data.note is string && data.note.size() <= 1000
        && data.createdAt is timestamp;
    }

    match /admins/{userId} {
      allow get: if isVerified() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isVerified() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if false;
      allow create: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && (request.auth.uid == userId || isAdmin())
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'unit', 'email', 'updatedAt']);
      allow delete: if false;
    }

    match /letters/{letterId} {
      allow get: if isVerified()
        && isValidId(letterId)
        && (existing().ownerId == request.auth.uid || request.auth.uid in existing().collaboratorUids || isAdmin());
      allow list: if isVerified()
        && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.collaboratorUids || isBootstrapAdmin());
      allow create: if isVerified()
        && isValidId(letterId)
        && isValidLetter(incoming())
        && incoming().ownerId == request.auth.uid
        && (request.auth.uid in incoming().collaboratorUids)
        && incoming().eventCount == 1
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(letterId)
        && isValidLetter(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().trackingCode == existing().trackingCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (existing().status != 'Diarsipkan' || isAdmin())
        && (
          isAdmin()
          || (
            existing().ownerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'letterNumber', 'agendaNumber', 'subject', 'sender', 'recipient',
              'originUnit', 'currentUnit', 'letterDate', 'receivedOrSentDate',
              'priority', 'classification', 'status', 'summary', 'attachmentUrl',
              'uploadedFileName', 'uploadedFileUrl', 'uploadedFileMime',
              'assignedToName', 'eventCount', 'updatedAt'
            ])
          )
          || (
            (request.auth.uid in existing().collaboratorUids)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'currentUnit', 'status', 'assignedToName', 'eventCount', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerified()
        && isValidId(letterId)
        && (existing().ownerId == request.auth.uid || isAdmin());

      match /trackingEvents/{eventId} {
        allow get: if isVerified()
          && isValidId(letterId)
          && isValidId(eventId)
          && (
            get(/databases/$(database)/documents/letters/$(letterId)).data.ownerId == request.auth.uid
            || request.auth.uid in get(/databases/$(database)/documents/letters/$(letterId)).data.collaboratorUids
            || isAdmin()
          );
        allow list: if isVerified()
          && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.collaboratorUids || isBootstrapAdmin());
        allow create: if isVerified()
          && isValidId(letterId)
          && isValidId(eventId)
          && isValidTrackingEvent(incoming(), letterId)
          && incoming().createdAt == request.time
          && getAfter(/databases/$(database)/documents/letters/$(letterId)).data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/letters/$(letterId)).data.ownerId == incoming().ownerId
          && getAfter(/databases/$(database)/documents/letters/$(letterId)).data.collaboratorUids == incoming().collaboratorUids
          && (
            getAfter(/databases/$(database)/documents/letters/$(letterId)).data.ownerId == request.auth.uid
            || request.auth.uid in getAfter(/databases/$(database)/documents/letters/$(letterId)).data.collaboratorUids
            || isAdmin()
          );
        allow update: if false;
        allow delete: if isVerified()
          && isValidId(letterId)
          && isValidId(eventId)
          && (
            get(/databases/$(database)/documents/letters/$(letterId)).data.ownerId == request.auth.uid
            || isAdmin()
          );
      }
    }
  }
}
